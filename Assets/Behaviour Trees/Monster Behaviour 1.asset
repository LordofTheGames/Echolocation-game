        Parents: []
        PortModels: []
        Text: "We set this again here to stop sounds played as the monster is moving
          (but which are quieter) \nresetting newSoundToInvestigate. We only want
          the monster to investigate one sound at a time"
    - rid: 104681498568295312
      type: {class: StickyNoteModel, ns: Unity.Behavior.GraphFramework, asm: Unity.Behavior.GraphFramework}
